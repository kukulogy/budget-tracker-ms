// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement()) // Primary Key
  firstname  String   // Firstname
  lastname   String   // Lastname
  email      String   @unique // Emails should be unique
  password   String   // SHA256 hash
  created_at DateTime @default(now()) // Timestamp when the user is created
  updated_at DateTime? @updatedAt     // Timestamp automatically updated on update
}